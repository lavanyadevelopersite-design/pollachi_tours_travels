PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tours_travels_crm
DB_USER=root
DB_PASSWORD=
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_REMEMBER_EXPIRY=30d
SESSION_INACTIVE_TIMEOUT_MINUTES=30
CORS_ORIGIN=http://localhost:5173
UPLOAD_MAX_SIZE_MB=10
LOG_LEVEL=info
# Optional free routing providers (OSRM used by default when unset).
# Driver trip route map uses the same providers — no Google Maps billing required.
OPENROUTESERVICE_API_KEY=
GEOAPIFY_API_KEY=

# Itinerary places search (optional; falls back to OpenStreetMap)
# PLACES_PROVIDER=google|geoapify|mapbox|openstreetmap
PLACES_PROVIDER=
GOOGLE_PLACES_API_KEY=
MAPBOX_API_KEY=

# WhatsApp via Wasender (https://wasenderapi.com)
WASENDER_ENABLED=true
WASENDER_API_KEY=
WASENDER_PERSONAL_ACCESS_TOKEN=
WASENDER_API_BASE=https://www.wasenderapi.com/api
WASENDER_API_URL=https://www.wasenderapi.com/api/send-message
WASENDER_UPLOAD_URL=https://www.wasenderapi.com/api/upload

# WhatsApp — WhatChimp (legacy, optional)
WHATCHIMP_ENABLED=false
WHATCHIMP_API_TOKEN=
WHATCHIMP_PHONE_NUMBER_ID=
# variable1 = customer name, variable2 = booking no, variable3 = travel date, variable4 = vehicle
# Template body example:
# Dear {{1}}, Your trip booking has been confirmed. Booking No: {{2}} Travel Date: {{3}} Vehicle: {{4}}
WHATCHIMP_TEMPLATE_NAME=trip_booking_confirmation
WHATCHIMP_TEMPLATE_ID=430257
WHATCHIMP_LANGUAGE_CODE=en_US
# Optional: public PDF URL for template document header (must be HTTPS and publicly accessible)
# WHATCHIMP_BOOKING_PDF_URL=https://yourdomain.com/files/booking-confirmation.pdf
# Public frontend URL used to build quotation links for PDF attachment
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
# Use your PC LAN IP or public domain so WhatsApp links are clickable on customer phones
# Example: ITINERARY_SHARE_BASE_URL=http://192.168.1.10:5000
ITINERARY_SHARE_BASE_URL=

# IMAGE_PROVIDER=google|unsplash|pexels|pixabay|wikimedia
IMAGE_PROVIDER=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
