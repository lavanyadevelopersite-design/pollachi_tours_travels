PORT=5000
HOST=0.0.0.0
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_cloudpanel_db
DB_USER=your_cloudpanel_db_user
DB_PASSWORD=your_cloudpanel_db_password

JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_min_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_REMEMBER_EXPIRY=30d
SESSION_INACTIVE_TIMEOUT_MINUTES=30

CORS_ORIGIN=https://cms.pollachitours.com
PUBLIC_APP_URL=https://cms.pollachitours.com
PUBLIC_API_URL=https://cms.pollachitours.com
ITINERARY_SHARE_BASE_URL=https://cms.pollachitours.com
UPLOAD_MAX_SIZE_MB=10
LOG_LEVEL=info
DB_SYNC=false
FRONTEND_DIST=
